{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__claude_ai_Watson-Nextcloud__nc_webdav_list_directory",
      "mcp__claude_ai_Watson-Nextcloud__nc_webdav_read_file",
      "mcp__claude_ai_Watson-Nextcloud__nc_webdav_find_by_name",
      "mcp__claude_ai_Watson-Nextcloud__nc_webdav_search_files",
      "Bash(git push *)",
      "Bash(py-spy dump:*)",
      "Bash(py-spy record:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true
}
