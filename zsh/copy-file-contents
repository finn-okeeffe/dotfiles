#!/usr/bin/env zsh

if (( $# != 1 )) || [[ ! -f $1 ]]; then
	print -u2 "Usage: copy-file-contents FILE"
	exit 1
fi

file=$1
extension=${${file:e}:l}

copy_windows_file() {
	local windows_file
	windows_file="$(wslpath -w -- "$1")" || return 1
	WINDOWS_CLIPBOARD_FILE="$windows_file" \
		powershell.exe -NoProfile -STA -Command '
			Add-Type -AssemblyName System.Windows.Forms
			$files = [System.Collections.Specialized.StringCollection]::new()
			[void] $files.Add($env:WINDOWS_CLIPBOARD_FILE)
			[System.Windows.Forms.Clipboard]::SetFileDropList($files)
		'
}

copy_windows_image() {
	local windows_file
	windows_file="$(wslpath -w -- "$1")" || return 1
	WINDOWS_CLIPBOARD_FILE="$windows_file" \
		powershell.exe -NoProfile -STA -Command '
			Add-Type -AssemblyName System.Windows.Forms
			$image = $null
			try {
				$image = [System.Drawing.Image]::FromFile($env:WINDOWS_CLIPBOARD_FILE)
				[System.Windows.Forms.Clipboard]::SetImage($image)
			} finally {
				if ($null -ne $image) { $image.Dispose() }
			}
		'
}

copy_converted_image() {
	local converted_image status
	converted_image="$(mktemp --suffix=.png)" || return 1
	if ! magick "$1" "$converted_image"; then
		rm -f -- "$converted_image"
		return 1
	fi
	copy_windows_image "$converted_image"
	status=$?
	rm -f -- "$converted_image"
	return "$status"
}

case $extension in
	pdf)
		copy_windows_file "$file"
		;;
	jpg|jpeg|jpe|png|gif|bmp|dib|tif|tiff|ico)
		copy_windows_image "$file"
		;;
	webp|avif|heic|heif|svg)
		copy_converted_image "$file"
		;;
	txt|text|md|markdown|rst|adoc|asciidoc|csv|tsv|log|json|jsonl|ndjson|toml|yaml|yml|xml|html|htm|css|scss|sass|less|sh|zsh|bash|fish|ps1|bat|cmd|c|h|cc|cpp|cxx|hpp|hxx|cs|go|rs|java|kt|kts|scala|swift|m|mm|php|pl|pm|rb|py|pyw|r|lua|vim|sql|js|mjs|cjs|jsx|ts|tsx|vue|svelte|ini|cfg|conf|config|properties|env|gitignore|gitattributes|gitmodules|editorconfig)
		clip.exe < "$file"
		;;
	*)
		print -u2 "copy-file-contents: unsupported file extension: .$extension"
		exit 1
		;;
esac
