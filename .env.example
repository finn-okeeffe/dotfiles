# Copy this file to ~/.env; the Bash and Zsh startup configs source it.

# Obsidian attachment imports (agent-skills/obsidian-save-response)
# Local vault, used by Codex and copy-image-to-vault.sh
export OBSIDIAN_VAULT_PATH="$HOME/obsidian-vault"
# Nextcloud vault, used by upload-image-to-nextcloud.sh. Create an app password under
# Nextcloud Settings > Security > Devices & sessions.
export NEXTCLOUD_URL="https://nc.finnokeeffe.nz"
export NEXTCLOUD_USER="whimsical"
export NEXTCLOUD_APP_PASSWORD=""
export NEXTCLOUD_VAULT_DIR="obsidian_vault"

# Mermaid rendering (agent-skills/make-docx-file)
export KROKI_URL="http://kroki:8000"

# PipeWire JACK latency (live-keyboard)
export PIPEWIRE_QUANTUM="128/48000"
